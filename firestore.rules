        && incoming().studentUid == existing().studentUid
        && (
          (isAcademicStaff() && incoming().diff(existing()).affectedKeys().hasOnly(['score', 'maxMarks', 'status', 'feedback', 'gradedBy', 'updatedAt'])) ||
          (
            existing().studentUid == request.auth.uid &&
            existing().status == 'submitted' &&
            incoming().status == 'submitted' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['submissionText', 'submissionUrl', 'fileName', 'fileDataUrl', 'updatedAt'])
          )
        );
      allow delete: if isValidId(submissionId) && isAdmin();
    }

    // Real-Time Student Academic Notifications (New Grades, Assignments, Assessments)
    match /student_notifications/{notifId} {
      allow get: if isValidId(notifId) && isVerifiedUser() && (
        isAcademicStaff() ||
        (isStudent() && (
          resource.data.targetScope == 'course' ||
          resource.data.targetStudentUid == request.auth.uid ||
          (hasUserDoc() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId == resource.data.targetStudentId)
        ))
      );
      allow list: if isVerifiedUser() && (
        isAcademicStaff() ||
        (isStudent() && (
          resource.data.targetScope == 'course' ||
          resource.data.targetStudentUid == request.auth.uid ||
          (hasUserDoc() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId == resource.data.targetStudentId)
        ))
      );
      allow create: if isValidId(notifId) && isAcademicStaff() && isValidStudentNotification(incoming())
        && exists(/databases/$(database)/documents/courses/$(incoming().courseId))
        && (isAdmin() || incoming().createdByUid == request.auth.uid);
      allow update: if isValidId(notifId) && isVerifiedUser() && isValidStudentNotification(incoming())
        && incoming().targetScope == existing().targetScope
        && incoming().courseId == existing().courseId
        && incoming().sourceId == existing().sourceId
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && (
          isAcademicStaff() ||
          (
            existing().targetScope == 'student' &&
            (
              existing().targetStudentUid == request.auth.uid ||
              (hasUserDoc() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId == existing().targetStudentId)
            ) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'updatedAt'])
          )
        );
      allow delete: if isValidId(notifId) && isAdmin();
    }

    // Collaborative Course Study Groups & Virtual Study Rooms
    match /study_groups/{groupId} {
      allow get: if isValidId(groupId) && isVerifiedUser() && (isAcademicStaff() || isStudent());
      allow list: if isVerifiedUser() && (isAcademicStaff() || isStudent());
      allow create: if isValidId(groupId) && isVerifiedUser() && (isStudent() || isAcademicStaff())
        && isValidStudyGroup(incoming())
        && incoming().creatorUid == request.auth.uid
        && incoming().status == 'active'
        && incoming().memberCount == 1
        && exists(/databases/$(database)/documents/courses/$(incoming().courseId))
        && existsAfter(/databases/$(database)/documents/study_groups/$(groupId)/members/$(request.auth.uid));
      allow update: if isValidId(groupId) && isVerifiedUser() && (isStudent() || isAcademicStaff())
        && isValidStudyGroup(incoming())
        && incoming().courseId == existing().courseId
        && incoming().creatorUid == existing().creatorUid
        && incoming().createdAt == existing().createdAt
        && (
          (
            (isAdmin() || existing().creatorUid == request.auth.uid) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'topic', 'scheduleNote', 'meetingUrl', 'maxMembers', 'status', 'updatedAt'])
          ) ||
          (
            existing().status == 'active' &&
            incoming().memberCount == existing().memberCount + 1 &&
            incoming().memberCount <= existing().maxMembers &&
            !exists(/databases/$(database)/documents/study_groups/$(groupId)/members/$(request.auth.uid)) &&
            existsAfter(/databases/$(database)/documents/study_groups/$(groupId)/members/$(request.auth.uid)) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['memberCount', 'updatedAt'])
          ) ||
          (
            incoming().memberCount == existing().memberCount - 1 &&
            incoming().memberCount >= 0 &&
            exists(/databases/$(database)/documents/study_groups/$(groupId)/members/$(request.auth.uid)) &&
            !existsAfter(/databases/$(database)/documents/study_groups/$(groupId)/members/$(request.auth.uid)) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['memberCount', 'updatedAt'])
          ) ||
          (
            existing().status == 'active' &&
            (isAdmin() || existing().creatorUid == request.auth.uid || exists(/databases/$(database)/documents/study_groups/$(groupId)/members/$(request.auth.uid))) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['sharedNotes', 'sharedNotesUpdatedBy', 'updatedAt'])
          )
        );
      allow delete: if isValidId(groupId) && isVerifiedUser() && (isAdmin() || existing().creatorUid == request.auth.uid);

      match /members/{memberUid} {
        allow get: if isValidId(groupId) && isValidId(memberUid) && isVerifiedUser() && (isAcademicStaff() || isStudent());
        allow list: if isValidId(groupId) && isVerifiedUser() && (isAcademicStaff() || isStudent());
        allow create: if isValidId(groupId) && isValidId(memberUid) && isVerifiedUser() && (isStudent() || isAcademicStaff())
          && memberUid == request.auth.uid
          && isValidStudyGroupMember(incoming())
          && incoming().groupId == groupId
          && incoming().uid == request.auth.uid
          && existsAfter(/databases/$(database)/documents/study_groups/$(groupId))
          && (
            incoming().role == 'member' ||
            getAfter(/databases/$(database)/documents/study_groups/$(groupId)).data.creatorUid == request.auth.uid
          );
        allow update: if false;
        allow delete: if isValidId(groupId) && isValidId(memberUid) && isVerifiedUser() && (
          isAdmin() ||
          memberUid == request.auth.uid ||
          get(/databases/$(database)/documents/study_groups/$(groupId)).data.creatorUid == request.auth.uid
        );
      }

      match /messages/{messageId} {
        allow get: if isValidId(groupId) && isValidId(messageId) && isVerifiedUser() && (
          isAdmin() ||
          isAcademicStaff() ||
          exists(/databases/$(database)/documents/study_groups/$(groupId)/members/$(request.auth.uid))
        );
        allow list: if isValidId(groupId) && isVerifiedUser() && (
          isAdmin() ||
          isAcademicStaff() ||
          exists(/databases/$(database)/documents/study_groups/$(groupId)/members/$(request.auth.uid))
        );
        allow create: if isValidId(groupId) && isValidId(messageId) && isVerifiedUser() && (isStudent() || isAcademicStaff())
          && isValidStudyGroupMessage(incoming())
          && incoming().groupId == groupId
          && incoming().senderUid == request.auth.uid
          && (
            isAdmin() ||
            isAcademicStaff() ||
            existsAfter(/databases/$(database)/documents/study_groups/$(groupId)/members/$(request.auth.uid))
          );
        allow update: if false;
        allow delete: if isValidId(groupId) && isValidId(messageId) && (
          isAdmin() ||
          existing().senderUid == request.auth.uid ||
          get(/databases/$(database)/documents/study_groups/$(groupId)).data.creatorUid == request.auth.uid
        );
      }
    }
  }
}
